--- a/Libraries/LibSandbox/Sandbox.cpp
+++ b/Libraries/LibSandbox/Sandbox.cpp
@@ -941,13 +941,23 @@
     if (TRY(count_threads()) != 1)
         return Error::from_string_literal("The file system must be restricted before the process starts a second thread");
 
+    // On distributions with unbundled ICU data (such as Alpine Linux), libicudata.so is a stub
+    // that lazily opens /usr/share/icu/<version>/icudt*.dat at runtime. Also allow /usr/share/zoneinfo
+    // and /etc/localtime read-only for timezone lookups inside sandboxed renderers.
+    Vector<PathRule> effective_paths;
+    for (auto const& path : paths)
+        TRY(effective_paths.try_append(path));
+    TRY(add_path_if_exists(effective_paths, "/usr/share/icu"sv, PathRule::Access::ReadOnly));
+    TRY(add_path_if_exists(effective_paths, "/usr/share/zoneinfo"sv, PathRule::Access::ReadOnly));
+    TRY(add_path_if_exists(effective_paths, "/etc/localtime"sv, PathRule::Access::ReadOnly));
+
     // Any failure means we can't have Landlock here: a kernel without it says ENOSYS or EOPNOTSUPP, and a container's
     // own seccomp filter can say anything.
     auto landlock_abi = syscall(__NR_landlock_create_ruleset, nullptr, 0, LANDLOCK_CREATE_RULESET_VERSION);
     if (landlock_abi > 0 && !sandbox_debugging_is_enabled())
-        return restrict_filesystem_with_landlock(paths, landlock_abi);
+        return restrict_filesystem_with_landlock(effective_paths.span(), landlock_abi);
 
-    return start_file_broker(paths);
+    return start_file_broker(effective_paths.span());
 }
 #endif
 
