+#if defined(AK_OS_LINUX) && !defined(AK_OS_ANDROID) && !defined(AK_LIBC_GLIBC)
+// musl's pthread_getattr_np() only probes currently mapped pages of the main thread's stack (~128 KiB at startup)
+// instead of RLIMIT_STACK (8 MiB). Expand the reported main-thread stack bounds to match glibc so C++ and Rust
+// callers (AK::StackInfo, ak::stack, LibJS/Rust parser & RegExp engine, libwasm_engine, Rust std) all see the true
+// stack limit.
+extern "C" __attribute__((visibility("default"))) int pthread_getattr_np(pthread_t thread, pthread_attr_t* attr)
+{
+    using PthreadGetattrNpFn = int (*)(pthread_t, pthread_attr_t*);
+    static auto real_pthread_getattr_np = reinterpret_cast<PthreadGetattrNpFn>(dlsym(RTLD_NEXT, "pthread_getattr_np"));
+    if (!real_pthread_getattr_np)
+        return ENOSYS;
+
+    int rc = real_pthread_getattr_np(thread, attr);
+    if (rc != 0)
+        return rc;
+
+    if (pthread_equal(thread, pthread_self()) && getpid() == static_cast<pid_t>(gettid())) {
+        void* base = nullptr;
+        size_t size = 0;
+        if (pthread_attr_getstack(attr, &base, &size) == 0 && base != nullptr && size > 0) {
+            auto top = reinterpret_cast<uintptr_t>(base) + size;
+            rlimit limit {};
+            if (getrlimit(RLIMIT_STACK, &limit) == 0) {
+                auto page_size = static_cast<size_t>(sysconf(_SC_PAGESIZE));
+                rlim_t full_size = (limit.rlim_cur == RLIM_INFINITY) ? static_cast<rlim_t>(8 * MiB) : limit.rlim_cur;
+                if (full_size > page_size)
+                    full_size -= page_size;
+                if (static_cast<size_t>(full_size) > size && top > static_cast<size_t>(full_size)) {
+                    auto* new_base = reinterpret_cast<void*>(top - static_cast<size_t>(full_size));
+                    (void)pthread_attr_setstack(attr, new_base, static_cast<size_t>(full_size));
+                }
+            }
+        }
+    }
+
+    return 0;
+}
+#endif
